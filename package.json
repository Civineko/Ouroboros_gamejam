{
  "name": "ouroboros-vue",
  "version": "0.1.1",
  "description": "圈一圈闭环生存小游戏",
  "author": "Civineko",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:offline": "vue-tsc --noEmit && vite build --mode offline",
    "check": "vue-tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "package:android": "npm run android:sync && cd android && ./gradlew assembleDebug && cd .. && node scripts/package-android.mjs",
    "package:web": "npm run build:offline && node scripts/package-web.mjs",
    "package:win": "npm run build:offline && electron-builder --win portable --x64",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@lucide/vue": "1.26.0",
    "phaser": "^4.2.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@types/node": "22.19.19",
    "@types/archiver": "6.0.3",
    "@vitejs/plugin-vue": "6.0.8",
    "archiver": "7.0.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "build": {
    "appId": "com.civineko.quanyiquan",
    "productName": "圈一圈",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist-offline/**/*",
      "desktop/**/*",
      "build-resources/icon.png",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build-resources/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QuanYiQuan-Demo-v${version}-Windows-${arch}.${ext}"
    }
  }
}
